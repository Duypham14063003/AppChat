# ============================================
# Nineteen Tech Internal App — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# Local dev defaults work out of the box with docker-compose.yml.

# --- PostgreSQL (local Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_19t
DB_NAME=app_19t_dev
DB_PASSWORD=local_dev_password

# --- Redis (local Docker) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- NestJS ---
PORT=3000
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CHAT_VIDEO_MAX_FILE_SIZE_MB=250

# --- PoC coordination ---
POC_REPORT_CONVERSATION_ID=35353995-517b-4fcb-b4d7-e0f23c5f4042
POC_REPORT_TIME=12:00
POC_TIMEZONE=Asia/Ho_Chi_Minh
POC_DAILY_CAPACITY_HOURS=8
POC_WEEKLY_CAPACITY_HOURS=40
POC_REMINDER_OFFSETS_MINUTES=1440,30

